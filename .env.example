PORT=8080
NODE_ENV=development

# 🍃 Base de Datos (Requerida por la rúbrica)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/shipnow

# 🔒 Seguridad & Sesiones
JWT_SECRET=tu_clave_secreta_super_segura
JWT_EXPIRES_IN=24h

# 🔴 Cache (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
